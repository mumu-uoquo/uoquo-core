  <!-- ================================================
     * 指定不同环境变量，可用变量：dev、test、demo、prod
     * 优先级：
     * 在编译打包时可以指定-P参数，将忽略profiles中的定义，如：mvn package -Ptest
     * 若没有system*.properties时，以dev模式打包
     * 若存在system.properties时，以prod模式打包
     * 若存在system-*.properties时，按 dev > test > demo > prod 的优先级打包
     * ================================================ -->
  <profiles>
    <!-- 没有system*.properties时，以dev模式打包 -->
    <profile>
      <id>default-dev</id>
      <properties>
        <environment.active>dev</environment.active>
      </properties>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
    </profile>
    <!-- 存在system.properties时，以prod模式打包 -->
    <profile>
      <id>default-prod</id>
      <properties>
        <environment.active>prod</environment.active>
      </properties>
      <activation>
        <file>
          <exists>src/main/resources/system.properties</exists>
        </file>
      </activation>
    </profile>
    <!-- 存在system-*.properties时，按 dev > test > demo > prod 的优先级打包 -->
    <profile>
      <id>prod</id>
      <properties>
        <environment.active>prod</environment.active>
      </properties>
      <activation>
        <file>
          <exists>src/main/resources/system-prod.properties</exists>
        </file>
      </activation>
    </profile>
    <profile>
      <id>demo</id>
      <properties>
        <environment.active>demo</environment.active>
      </properties>
      <activation>
        <file>
          <exists>src/main/resources/system-demo.properties</exists>
        </file>
      </activation>
    </profile>
    <profile>
      <id>test</id>
      <properties>
        <environment.active>test</environment.active>
      </properties>
      <activation>
        <file>
          <exists>src/main/resources/system-test.properties</exists>
        </file>
      </activation>
    </profile>
    <profile>
      <id>dev</id>
      <properties>
        <environment.active>dev</environment.active>
      </properties>
      <activation>
        <file>
          <exists>src/main/resources/system-dev.properties</exists>
        </file>
      </activation>
    </profile>
  </profiles>

  <!-- 全局build配置，所有项目编译时都会执行 -->
  <build>
    <!-- 打包时过滤properties和yaml文件，与maven-resources-plugin配合使用 -->
    <resources>
      <resource>
        <directory>src/main/java</directory>
        <filtering>false</filtering><!-- 是否替换资源中的属性-->
        <includes>
          <include>**/*.properties</include>
          <include>**/*.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>dll/**</exclude>
          <exclude>lib/**</exclude>
          <exclude>dev/**</exclude>
          <exclude>test/**</exclude>
          <exclude>demo/**</exclude>
          <exclude>prod/**</exclude>
          <exclude>**/*.sh</exclude>
          <exclude>**/*.bat</exclude>
        </excludes>
      </resource>
      <resource><!-- 指定环境的信息（会覆盖根目录下的同名文件！） -->
        <directory>src/main/resources/${environment.active}</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/*.sh</exclude>
          <exclude>**/*.bat</exclude>
        </excludes>
      </resource>
    </resources>

    <!-- 声明plugin，每个项目都会生效 -->
    <plugins>
      <!-- 将打包时过滤的properties和yaml文件，复制到conf目录下 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
        <executions>
          <!-- 复制配置信息到config -->
          <execution>
            <id>copy-resources</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/config</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.properties</include>
                    <include>**/*.yml</include>
                  </includes>
                  <excludes>
                    <exclude>dev/**</exclude>
                    <exclude>test/**</exclude>
                    <exclude>demo/**</exclude>
                    <exclude>prod/**</exclude>
                  </excludes>
                </resource>
                <resource><!-- 指定环境的信息（会覆盖根目录下的同名文件！） -->
                  <directory>src/main/resources/${environment.active}</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.properties</include>
                    <include>**/*.yml</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- 复制启动文件到根目录 -->
          <execution>
            <id>copy-boot</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>*.sh</include>
                    <include>*.bat</include>
                  </includes>
                </resource>
                <resource><!-- 指定环境的信息（会覆盖根目录下的同名文件！） -->
                  <directory>src/main/resources/${environment.active}</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>*.sh</include>
                    <include>*.bat</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- 将dll、so文件复制到lib -->
          <execution>
            <id>copy-dll</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <resources>
                <!-- 不保留目录结构，全部放到lib下 -->
                <resource>
                  <directory>src/main/resources/lib</directory>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>src/main/resources/dll</directory>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>src/main/resources/so</directory>
                  <filtering>false</filtering>
                </resource>
                <!-- 会保留目录结构，在lib下按照原目录生成 -->
                <!-- <resource>-->
                <!--     <directory>src/main/resources</directory>-->
                <!--     <filtering>false</filtering>-->
                <!--     <includes>-->
                <!--         <include>**/*.dll*</include>-->
                <!--         <include>**/*.so*</include>-->
                <!--         <include>**/*.lib*</include>-->
                <!--     </includes>-->
                <!-- </resource>-->
              </resources>
            </configuration>
          </execution>
          <!-- 将lib文件复制到lib下 -->
          <execution>
            <id>copy-lib</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources/lib</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- 编译时忽略测试出错的影响 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <skip>true</skip> <!-- mvn install 时跳过test -->
          <skipTests>true</skipTests> <!-- 跳过test -->
          <testFailureIgnore>true</testFailureIgnore>
        </configuration>
      </plugin>
      <!-- 打包git标识 -->
      <!-- https://mvnrepository.com/artifact/io.github.git-commit-id/git-commit-id-maven-plugin -->
      <!-- https://github.com/git-commit-id/git-commit-id-maven-plugin/blob/master/docs/using-the-plugin.md -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>10.0.0</version>
        <executions>
          <execution>
            <id>get-the-git-infos</id>
            <goals>
              <goal>revision</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
        </executions>
        <configuration>
          <!-- 日期格式（yyyy-MM-dd'T'HH:mm:ssZ） -->
          <dateFormat>yyyy-MM-dd'T'HH:mm:ssZ</dateFormat>
          <!-- 构建过程时打印详细信息（false） -->
          <verbose>false</verbose>
          <format>json</format>
          <!-- ".git"文件路径;默认值:${project.basedir}/.git -->
          <dotGitDirectory>${project.basedir}/.git</dotGitDirectory>
          <!-- 无".git"文件夹时,构建是否失败（true） -->
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <!-- 生成"git.properties"文件（false） -->
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <!-- 指定"git.properties"文件的存放路径(相对于${project.basedir}的一个路径，默认为根) -->
          <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
          <commitIdGenerationMode>full</commitIdGenerationMode>
          <!-- git描述配置,由JGit提供实现（https://git-scm.com/docs/git-describe） -->
          <gitDescribe>
            <!-- 是否生成描述属性 -->
            <skip>false</skip>
            <!-- 未发现tag时,仅打印提交操作ID -->
            <always>false</always>
            <!-- 提交操作ID显式字符长度,最大值为:40;默认值:7 -->
            <abbrev>7</abbrev>
            <!-- 对含未提交代码(即"dirty state")构建时,添加指定后缀;默认值:""; -->
            <dirty>-dirty</dirty>
            <!--always print using the "tag-commits_from_tag-g_commit_id-maybe_dirty" format, even if "on" a tag.
                The distance will always be 0 if you're "on" the tag.
            -->
            <forceLongFormat>false</forceLongFormat>
          </gitDescribe>
        </configuration>
      </plugin>
      <!-- 设置编译版本 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <release>${java.version}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <!-- 必须开启这个，SpEL才能按参数名绑定 -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>

    <!-- 声明plugin，不会被引入，需在实际pom中手动引入plugin -->
    <pluginManagement>
      <plugins>
        <!-- 配置生成Javadoc包 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <encoding>${project.build.sourceEncoding}</encoding>
            <charset>${project.build.sourceEncoding}</charset>
            <docencoding>${project.build.sourceEncoding}</docencoding>
            <!-- 禁用Javadoc严格语法校验（适配OpenJDK模块化规则） -->
            <additionalOptions>
              <additionalOption>-Xdoclint:none</additionalOption>
            </additionalOptions>
            <!-- 兼容写法：同时添加doclint节点，适配模块化Javadoc规则 -->
            <doclint>none</doclint>
            <!-- 避免因为文档错误中断构建 -->
            <failOnError>false</failOnError>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <phase>package</phase>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- 配置生成source包 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <phase>verify</phase>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- 拷贝依赖的jar包到lib目录 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.10.0</version>
          <executions>
            <execution>
              <id>copy-dependencies</id>
              <phase>package</phase>
              <goals>
                <goal>copy-dependencies</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <!-- <includeScope>runtime</includeScope>-->
            <!-- 拷贝依赖包到指定目录下 -->
            <outputDirectory>${project.build.directory}/lib</outputDirectory>
          </configuration>
        </plugin>
        <!-- 打包jar文件时，配置manifest文件，加入config和lib包的jar依赖 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <!-- 将配置文件排除在jar包 -->
            <excludes>
            </excludes>
            <archive>
              <!-- 生成的jar中，包含pom.xml和pom.properties这两个文件 -->
              <addMavenDescriptor>true</addMavenDescriptor>
              <!-- 将lib下的jar包加入classpath -->
              <manifest>
                <addClasspath>false</addClasspath>
                <!-- 瘦身模式1：采用java标准打包（非springboot打包），将分离到外部的lib依赖包路径写入MANIFEST.MF的classpath中   -->
                <!-- 运行方式：java -jar ${project}.jar   -->
                <!--
                <addClasspath>true</addClasspath>
                <classpathPrefix>lib/</classpathPrefix>
                -->
                <!-- 支持Spring注解自动扫描Jar中的类 -->
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
              </manifest>
              <!-- 默认将config加入classpath -->
              <manifestEntries>
                <Class-Path>config/</Class-Path>
              </manifestEntries>
            </archive>
            <classesDirectory>
            </classesDirectory>
          </configuration>
        </plugin>
        <!-- 打包war文件时，配置manifest文件，加入config和lib包的jar依赖. -->
        <!-- 注：web项目，目前不采用war发布，而是传统方式部署,             -->
        <!--    但指定项目为war时，maven默认会打war包,                   -->
        <!--    因此为了加快打包速度，static、lib文件夹不打包到war中.      -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <!-- <archiveClasses>true</archiveClasses> --><!-- 将classes打成jar包. -->
            <failOnMissingWebXml>false</failOnMissingWebXml><!-- 忽略web.xml文件. -->
            <warSourceExcludes><!-- 从resource（webapp）复制时忽略. -->
              static/**,         <!-- 不将static打入war包. -->
              css/**,            <!-- 不将css打入war包. -->
              js/**              <!-- 不将js打入war包. -->
            </warSourceExcludes>
            <packagingExcludes><!-- 打包时忽略. -->
              WEB-INF/lib/*.jar <!-- 不将jar打入war包. -->
            </packagingExcludes>
            <archive>
              <!-- 将lib下的jar包加入classpath -->
              <manifest>
                <addClasspath>false</addClasspath>
                <!-- 打包为可执行文件时，需要将依赖包打入classpath -->
                <!--
                <addClasspath>true</addClasspath>
                <classpathPrefix>lib/</classpathPrefix>
                -->
                <!-- 支持Spring注解自动扫描Jar中的类 -->
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
              </manifest>
              <!-- 将config加入classpath -->
              <manifestEntries>
                <Class-Path>config/</Class-Path>
              </manifestEntries>
            </archive>
            <classesDirectory>
            </classesDirectory>
          </configuration>
        </plugin>

        <!-- springboot打包 -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
          <configuration>
            <!-- 会自动加载标注了 @SpringBootApplication 的启动类 -->
            <!-- <mainClass>${start-class}</mainClass> -->
            <!-- 2.1.4 之后不包含该属性 -->
            <finalName>${project.artifactId}</finalName>
            <!-- 3.x 之后默认可执行，不再需要该属性，已被移除 -->
            <!-- <executable>true</executable> -->
            <excludeDevtools>false</excludeDevtools>
            <!-- <classifier>exec</classifier> --><!-- 可执行包的后缀 -->
            <!-- 瘦身模式2：采用springboot的ZIP方式（推荐），配合 maven-dependency-plugin 使用. -->
            <!-- 运行方式：java -Dloader.path=lib -jar ${project}.jar   -->
            <!-- 默认不采用瘦身模式打包，方便docker部署. -->
            <!--
            <layout>ZIP</layout>
            <includes>
                <include>
                    <groupId>nothing</groupId>
                    <artifactId>nothing</artifactId>
                </include>
            </includes>
            -->
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
          <dependencies>
            <!-- 热部署，仅对mvn spring-boot:run这种启动方式生效 -->
            <!--
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>springloaded</artifactId>
                <version>${spring-loaded.version}</version>
            </dependency>
            -->
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>