<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.uoquo</groupId>
  <artifactId>dependencies</artifactId>
  <version>1.1.0</version>
  <packaging>pom</packaging>
  <description>定义各个依赖包版本</description>

  <organization>
    <name>uoquo</name>
    <url>http://www.uoquo.com</url>
  </organization>

  <!-- 参数定义，主要定义常用jar的版本信息，便于升级维护 -->
  <properties>
    <uoquo.version>1.1.0</uoquo.version>
    <!-- 版本信息，子类中将会继承引用 -->
    <PublicRepository>https://mvn.uoquo.com/repository/maven-public/</PublicRepository>
    <ReleaseRepository>https://mvn.uoquo.com/repository/maven-releases/</ReleaseRepository>
    <SnapshotRepository>https://mvn.uoquo.com/repository/maven-snapshots/</SnapshotRepository>
    <!-- maven编译的JDk环境 -->
    <java.version>21</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
    <maven.test.skip>true</maven.test.skip>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 其他依赖包版本 -->
    <!-- SpringBoot 2.x : jdk 1.8 -->
    <!-- SpringBoot 3.x : jdk 17  -->
    <!-- https://spring.io/projects/spring-cloud -->
    <!-- https://github.com/spring-cloud/spring-cloud-release/wiki/Supported-Versions -->
    <!-- https://mvnrepository.com/artifact/org.springframework.cloud/spring-cloud-dependencies -->
    <spring.cloud.version>2025.0.2</spring.cloud.version>
    <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-dependencies -->
    <spring.boot.version>3.5.14</spring.boot.version>

    <!-- https://github.com/alibaba/spring-cloud-alibaba/wiki/版本说明 -->
    <!-- https://github.com/alibaba/spring-cloud-alibaba/wiki/Sentinel -->
    <!-- https://mvnrepository.com/artifact/com.alibaba.cloud -->
    <alibaba.version>2025.0.0.0</alibaba.version>
    <!-- https://nacos.io -->
    <!-- https://mvnrepository.com/artifact/com.alibaba.nacos/nacos-client -->
    <nacos.version>2.4.3</nacos.version>
    <!-- https://seata.apache.org -->
    <!-- https://mvnrepository.com/artifact/org.apache.seata/seata-spring-boot-starter -->
    <seata.version>2.6.0</seata.version>
    <!-- https://github.com/alibaba/druid/releases -->
    <!-- https://mvnrepository.com/artifact/com.alibaba/druid-spring-boot-starter -->
    <druid.version>1.2.28</druid.version>

    <!-- https://mvnrepository.com/artifact/javax.servlet/javax.servlet-api -->
    <servlet.javax>4.0.1</servlet.javax>
    <!-- https://mvnrepository.com/artifact/jakarta.servlet/jakarta.servlet-api -->
    <servlet.jakarta>6.1.0</servlet.jakarta>
    <!-- https://mvnrepository.com/artifact/jakarta.validation/jakarta.validation-api -->
    <validate.jakarta>3.1.1</validate.jakarta>
    <validate.hibernate>8.0.2.Final</validate.hibernate>
    <!-- https://mvnrepository.com/artifact/jakarta.annotation/jakarta.annotation-api -->
    <annotation.jakarta>3.0.0</annotation.jakarta>

    <!-- https://mvnrepository.com/artifact/org.json/json -->
    <json.version>20251224</json.version>
    <!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
    <gson.version>2.11.0</gson.version>
    <!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
    <!-- jackson 版本由 spring-boot-dependencies BOM 管理 -->
    <!-- <jackson.version>2.18.3</jackson.version> -->
    <!-- https://mvnrepository.com/artifact/com.alibaba/fastjson -->
    <fastjson.version>2.0.56</fastjson.version>
    <!-- https://mvnrepository.com/artifact/org.dom4j/dom4j -->
    <dom4j.version>2.1.1</dom4j.version>

    <!-- https://mvnrepository.com/artifact/com.h2database/h2 -->
    <h2.version>2.4.240</h2.version>
    <!-- 推荐：https://mvnrepository.com/artifact/com.mysql/mysql-connector-j -->
    <mysql-j.version>9.7.0</mysql-j.version>
    <!-- https://mvnrepository.com/artifact/mysql/mysql-connector-java -->
    <!-- com.mysql.cj.jdbc.Driver : 8.0.33 -->
    <!-- com.mysql.jdbc.Driver    : 5.1.48 -->
    <mysql.version>8.0.33</mysql.version><!-- seata必须使用mysql5.1.48以上 -->
