    <okhttp3.version>4.12.0</okhttp3.version>
    <!-- https://mvnrepository.com/artifact/com.google.zxing/core -->
    <zxing.version>3.5.2</zxing.version>
    <!-- https://mvnrepository.com/artifact/org.ehcache/ehcache -->
    <ehcache.version>3.8.1</ehcache.version>
    <!-- https://mvnrepository.com/artifact/jakarta.mail/jakarta.mail-api -->
    <mail.jakarta>2.1.5</mail.jakarta>

    <!-- https://mvnrepository.com/artifact/com.itextpdf -->
    <itext.version>7.1.10</itext.version>
    <!-- https://mvnrepository.com/artifact/org.apache.poi -->
    <poi.version>4.1.2</poi.version>
    <!-- https://mvnrepository.com/artifact/org.yaml/snakeyaml -->
    <yaml.version>2.0</yaml.version>

    <!-- https://mvnrepository.com/artifact/io.swagger.core.v3/swagger-annotations -->
    <swagger-v3.version>2.2.49</swagger-v3.version>
    <!-- https://mvnrepository.com/artifact/io.springfox/springfox-boot-starter -->
    <!-- spring boot 2.5.x 之前可以用 springfox -->
    <springfox.version>3.0.0</springfox.version>
    <!-- 推荐：https://springdoc.org -->
    <!-- https://mvnrepository.com/artifact/org.springdoc/springdoc-openapi-starter-webmvc-ui -->
    <!-- 1.8.0: spring 1.x、spring 2.x -->
    <!-- 2.8.4: spring 3.x -->
    <springdoc.version>2.8.17</springdoc.version>

    <!-- https://mvnrepository.com/artifact/io.netty/netty-all -->
    <netty.version>4.2.14.Final</netty.version>

    <!-- https://mvnrepository.com/artifact/org.slf4j -->
    <slf4j.version>2.0.18</slf4j.version>
    <!-- https://mvnrepository.com/artifact/ch.qos.logback/logback-classic -->
    <logback.version>1.5.32</logback.version>
  </properties>

  <!-- 仓库信息，用于查找jar（注意仓库id与settings.xml中server的id一致） -->
  <repositories>
    <repository>
      <id>xuziu-mvn-reader</id>
      <name>Team Nexus jar Repository</name>
      <url>${PublicRepository}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>xuziu-mvn-reader</id>
      <name>Team Nexus plugin Repository</name>
      <url>${PublicRepository}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <!-- 分发管理，主要用于maven打包发布（注意仓库id与settings.xml中server的id一致） -->
  <distributionManagement>
    <repository>
      <id>xuziu-mvn-deploy</id>
      <name>Team Release Repository</name>
      <url>${ReleaseRepository}</url>
    </repository>
    <snapshotRepository>
      <id>xuziu-mvn-reader</id>
      <name>Team Snapshot Repository</name>
      <url>${SnapshotRepository}</url>
      <uniqueVersion>false</uniqueVersion>
    </snapshotRepository>
  </distributionManagement>

  <!-- 项目必须引入的jar包 -->
  <dependencies>
    <!-- =================== log相关 =================== -->
    <!-- 使用 spring-boot-starter-logging 统一管理日志依赖（logback + slf4j bridges），
         版本由 spring-boot-dependencies BOM 管理，避免手动指定版本导致的冲突 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-logging</artifactId>
      <version>${spring.boot.version}</version>
    </dependency>
    <!-- =================== 测试相关 =================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring.boot.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- 声明依赖jar，不会被引入，需在实际pom中手动引入dependency -->
  <dependencyManagement>
    <dependencies>
      <!-- =================== spring boot =================== -->
      <!-- spring boot 不以parent的方式引入，
         - 详情 https://docs.spring.io/spring-boot/docs/current/reference/html/using-boot-build-systems.html#using-boot-maven-without-a-parent
         - 使用scope=import的方式实现多继承parent pom的模式
         - -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 引入spring boot，排除内置容器，方便导出后可以部署到外部容器中，开发时可以引入内部容器相关包 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-web</artifactId>
        <version>${spring.boot.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <!-- =================== spring cloud =================== -->
      <!-- 版本 https://spring.io/projects/spring-cloud#learn -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring.cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Spring Cloud 组件（openfeign、loadbalancer、context 等）版本由上方 BOM 统一管理，
           子项目按需在 <dependencies> 中引入即可，无需指定版本 -->
      <!-- bootstrap 支持在 Spring Cloud 2025.0.x 中已从 BOM 移除，需显式指定版本 -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-starter-bootstrap</artifactId>
        <version>4.3.2</version>
      </dependency>
      <!-- 熔断：hystrix 已在 Spring Cloud 2020+ 移除，使用 Spring Cloud Circuit Breaker 替代 -->
      <!-- 如需熔断功能，请使用 spring-cloud-starter-circuitbreaker-resilience4j -->
      <!--
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        <version>3.2.2</version>
      </dependency>
      -->

